# Copy to .env, fill in, then: chmod 600 .env   (never commit .env)
# Generate passwords with: openssl rand -base64 32

# Public address (DNS A/AAAA record pointing at this host) and the certificate contact.
MEIP_DOMAIN=pilot.example.co.uk
MEIP_ACME_EMAIL=ops@example.co.uk

# Database roles.
POSTGRES_SUPERUSER_PASSWORD=
MEIP_OWNER_DB_PASSWORD=
MEIP_APP_DB_PASSWORD=

# OpenAI (server-side only). Use a project key restricted to this deployment.
MEIP_OPENAI_API_KEY=
MEIP_OPENAI_MODEL=gpt-4.1

# Documents stay OFF until the legal and privacy prerequisites are met (runbook, section 1).
# Then set both: the second is your reference to the approved retention decision (D10).
MEIP_DOCUMENTS_ENABLED=false
MEIP_DOCUMENT_RETENTION_APPROVAL=

# Bank statements stay refused unless a DPIA covers them. Then set both.
MEIP_BANK_STATEMENTS_ENABLED=false
MEIP_ACCOUNT_FINGERPRINT_KEY=

# Sign-in session length, minutes.
MEIP_SESSION_MINUTES=480
