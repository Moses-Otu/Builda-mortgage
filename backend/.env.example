# Copy to backend/.env for local runs outside Docker. Never commit a real .env.
# MEIP_ENV is required (local | test | staging | production); there is no default.
MEIP_ENV=local
MEIP_LOG_JSON=false
MEIP_DATABASE_URL=postgresql+asyncpg://meip_app:meip_app_local@localhost:5432/meip
MEIP_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://meip_owner:meip_owner_local@localhost:5432/meip

# Local development: tokens minted by `meip-admin dev-token`.
MEIP_AUTH_MODE=dev
MEIP_DEV_AUTH_KEY_PATH=.dev/dev_auth_key.pem

# Real identity provider (staging/production). Entra External ID example values:
# MEIP_AUTH_MODE=oidc
# MEIP_OIDC_ISSUER=https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0
# MEIP_OIDC_AUDIENCE=<api-application-client-id>
# MEIP_OIDC_JWKS_URL=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
# Stable user identifier: Entra 'oid' (default). Never 'sub' with Entra (it is per client app).
# MEIP_OIDC_SUBJECT_CLAIM=oid
# Pin tokens to your directory via the 'tid' claim:
# MEIP_OIDC_TENANT_ID=<tenant-id>

# Documents (Phase 2.0). Off unless enabled. SYNTHETIC documents only until the retention
# and erasure decision (D10) is approved; outside local/test, enabling also requires
# MEIP_DOCUMENT_RETENTION_APPROVAL=<D10 reference>, or the service refuses to start.
MEIP_DOCUMENTS_ENABLED=true
MEIP_BLOB_BACKEND=filesystem
MEIP_BLOB_ROOT=.dev/blobs
# Or Azurite (docker compose up azurite; then: uv run meip-admin init-storage):
# MEIP_BLOB_BACKEND=azure
# MEIP_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
